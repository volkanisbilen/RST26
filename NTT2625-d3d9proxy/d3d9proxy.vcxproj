<?xml version="1.0" encoding="utf-8"?>
<!-- d3d9 proxy (x86 DLL) for the 2625 client. Replaces build.bat: open d3d9proxy.sln in VS2022, Release | Win32, Build.
     New .cpp files: add them to the project (Solution Explorer > Add > Existing Item).
     Post-build: copies d3d9.dll into GameDir (old one kept as d3d9.dll.bak) only while the game is closed.
     GameDir can be changed below or with msbuild /p:GameDir=...  /p:Deploy=false builds without copying. -->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{7D3A9E52-4C1B-4F6A-9B2E-2625D3D90001}</ProjectGuid>
    <RootNamespace>d3d9proxy</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <WholeProgramOptimization>false</WholeProgramOptimization>
    <CharacterSet>NotSet</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)'==''">D:\ai\2625_Client</GameDir>
    <Deploy Condition="'$(Deploy)'==''">true</Deploy>
    <OutDir>$(ProjectDir)</OutDir>
    <IntDir>$(ProjectDir)obj\$(Configuration)\</IntDir>
    <TargetName>d3d9</TargetName>
    <TargetExt>.dll</TargetExt>
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <ExceptionHandling>Sync</ExceptionHandling>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <WarningLevel>Level1</WarningLevel>
      <SDLCheck>false</SDLCheck>
      <ConformanceMode>false</ConformanceMode>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <DebugInformationFormat>None</DebugInformationFormat>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <ModuleDefinitionFile>d3d9.def</ModuleDefinitionFile>
      <AdditionalDependencies>user32.lib;gdi32.lib;msimg32.lib;crypt32.lib;advapi32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <GenerateDebugInformation>false</GenerateDebugInformation>
      <ImportLibrary>$(IntDir)d3d9proxy.lib</ImportLibrary>
    </Link>
    <PostBuildEvent Condition="'$(Deploy)'=='true'">
      <Command>tasklist /FI "IMAGENAME eq KnightOnLine.exe" | find /I "KnightOnLine.exe" &gt;nul &amp;&amp; (echo OYUN ACIK: d3d9.dll derlendi ama oyuna kopyalanmadi. Oyunu kapatip tekrar derleyin. &amp; exit /b 0)

if exist "$(GameDir)\d3d9.dll" copy /y "$(GameDir)\d3d9.dll" "$(GameDir)\d3d9.dll.bak" &gt;nul

copy /y "$(TargetPath)" "$(GameDir)\d3d9.dll" &amp;&amp; echo TAMAM: d3d9.dll oyuna kopyalandi ($(GameDir))

exit /b 0</Command>
      <Message>d3d9.dll oyuna kopyalaniyor (oyun kapaliysa)</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>
