[Unit]
Description=JstKO standalone admin panel (ko-admin)
After=network.target postgresql.service

[Service]
# same DATABASE_URL / ADMIN_USERNAME / ADMIN_PASSWORD_HASH as the game server
EnvironmentFile=/etc/ko-server.env
Environment=ADMIN_BIND_ADDR=0.0.0.0:8090
Environment=ITEM_ICON_DIR=/var/www/jstkoadminpanel2/public/assets/img/itemicon
Environment=JSTKO_QUEST_DIR=/opt/ko26xx/Quests
WorkingDirectory=/opt/ko26xx
ExecStart=/opt/ko26xx/ko-admin
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
