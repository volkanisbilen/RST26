# Defense in depth only -- the real fix is pointing your hosting's document root at
# web-panel/public_html/, not at web-panel/ itself. If the host ever serves this folder anyway,
# this blocks every request to it.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
