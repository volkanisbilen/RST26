# These files only ever get require'd by the pages in public_html/, never requested directly --
# this blocks direct HTTP access to all of them (DB credentials live in config.php next door,
# not in here, but there's no reason any of this should be web-reachable either).
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
