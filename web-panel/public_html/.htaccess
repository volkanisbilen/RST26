# config.php holds the database/SMTP passwords. Requesting it directly just gets PHP to run it
# (it only `return`s an array, so normally the response is blank either way) but this blocks it
# outright so a misconfigured PHP handler can never show the raw source instead of running it.
<FilesMatch "^config(\.example)?\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
